@InventoryApi_HostAddress = http://localhost:5230

GET {{InventoryApi_HostAddress}}/weatherforecast/
Accept: application/json

###
POST http://localhost:5230/api/products
Content-Type: application/json

{
    "productName": "",
    "price": -500,
    "stock": -10,
    "category": "Electronics"
}

###

DELETE http://localhost:5230/api/products/7
Content-Type: application/json

{
    "productName": "Webcam",
    "price": 3000,
    "stock": 20,
    "category": "Accessories"
}
###

GET http://localhost:5230/api/products/filter?category=Electronics&minPrice=10000

###

GET http://localhost:5230/api/products/search?name=Lap

### Get Cheapest Product
GET http://localhost:5230/api/products/cheapest

### Sort Products by Highest Price
GET http://localhost:5230/api/products/sort-by-price

### Pagination - Page 1
GET http://localhost:5230/api/products/paged?pageNumber=1&pageSize=2

### Pagination - Page 2
GET http://localhost:5230/api/products/paged?pageNumber=2&pageSize=2

### Invalid Pagination
GET http://localhost:5230/api/products/paged?pageNumber=0&pageSize=100

### Get All Products
GET {{InventoryApi_HostAddress}}/api/products
Accept: application/json

###

### Get Product By ID
GET {{InventoryApi_HostAddress}}/api/products/1
Accept: application/json

###

### Update Product - Valid Data
PUT {{InventoryApi_HostAddress}}/api/products/1
Content-Type: application/json

{
    "productName": "Gaming Laptop",
    "price": 75000,
    "stock": 20,
    "category": "Electronics"
}

###

### Update Product - Invalid Data
PUT {{InventoryApi_HostAddress}}/api/products/1
Content-Type: application/json

{
    "productName": "",
    "price": -500,
    "stock": -10,
    "category": "Electronics"
}

###